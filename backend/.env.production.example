# Production settings for the Render web service. Paste each line into Render > Environment.
# Never commit real values: this file only lists the names.

# App name shown in emails and logs.
APP_NAME=UniFind
# Production mode.
APP_ENV=production
# Never show error details to visitors.
APP_DEBUG=false
# Encryption key: run `php artisan key:generate --show` locally and paste the output (base64:...).
APP_KEY=
# Public URL of this API on Render, e.g. https://unifind-api.onrender.com (set after the first deploy).
APP_URL=
# Send logs to Render's log viewer.
LOG_CHANNEL=stderr

# Database driver.
DB_CONNECTION=mysql
# Aiven MySQL host.
DB_HOST=
# Aiven MySQL port.
DB_PORT=
# Aiven database name (defaultdb).
DB_DATABASE=
# Aiven user (avnadmin).
DB_USERNAME=
# Aiven password (from the Aiven console).
DB_PASSWORD=
# Aiven CA certificate inside the container: /var/www/html/storage/certs/ca.pem
MYSQL_ATTR_SSL_CA=

# Password of admin@uqu.edu.sa (strong, not the local one); applied on every deploy.
ADMIN_PASSWORD=
# Password of student@uqu.edu.sa (strong, not the local one); applied on every deploy.
STUDENT_PASSWORD=

# Allowed browser origin(s) for CORS, comma-separated, no path: https://itrm98.github.io
FRONTEND_URL=
# API token lifetime in minutes (e.g. 720 = 12 hours).
SANCTUM_EXPIRATION=

# Store item photos on the s3 disk (Cloudflare R2).
UPLOADS_DISK=s3
# R2 API token Access Key ID.
AWS_ACCESS_KEY_ID=
# R2 API token Secret Access Key.
AWS_SECRET_ACCESS_KEY=
# R2 uses the region "auto".
AWS_DEFAULT_REGION=auto
# R2 bucket name.
AWS_BUCKET=
# R2 S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com (without the bucket name).
AWS_ENDPOINT=
# R2 public bucket URL, e.g. https://pub-xxxxxxxx.r2.dev (used to build photo URLs).
AWS_URL=
# R2 needs path-style requests.
AWS_USE_PATH_STYLE_ENDPOINT=true
